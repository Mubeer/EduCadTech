# ========================================================
# EduCadTech — .gitignore
# ========================================================

# Dependency directories
node_modules/
jspm_packages/

# SQLite runtime temporary/lock files (WAL & shared memory)
db/*.sqlite-shm
db/*.sqlite-wal

# Temporary, scratch, and test files
scratch/
temp.html
*.tmp

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Editor & IDE directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
